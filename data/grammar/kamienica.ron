// R3 — kamienica czynszowa w pierzei. Przykład wzorcowy z M2 §5.6: parter usługowy
// wyższy od pięter (stąd osobne `ground_height_m`), zabudowa obrzeżna bez cofnięć,
// dziedziniec, gdy działka jest głęboka.
(
    schema_version: 1,
    id: "kamienica",
    applies: (
        // R4 i R5 **w epokach przedblokowych**: gęsta zabudowa mieszkaniowa z 1890 roku
        // jest kamienicą, a nie blokiem, którego wtedy nie było. Bez tego pierścień
        // średniowieczny i przemysłowy w strefie R4 nie miał ani jednej gramatyki
        // i dobór lądował na rozluźnieniu filtru epoki — 15,5 % budynków (korekta I-13).
        zones: ["r3", "r4", "r5", "commercial", "office"],
        epochs: ["medieval", "industrial", "interwar"],
        styles: [],
        land_value: (1800, 9000000),
        frontage_m: (5.0, 120.0),
        depth_m: (5.0, 120.0),
        weight: 45,
    ),
    massing: (
        setback_front_m: 0.0,
        setback_side_m: 0.0,
        setback_back_m: 2.0,
        courtyard_min_m2: 90.0,
        max_depth_m: 15.0,
    ),
    rules: [
        Foundation(depth_m: 2.5, material: "brick_red", basements: 1),
        Floors(
            count: (3, 6),
            height_m: 3.2,
            ground_height_m: 4.2,
            ground: Ref("parter_uslugowy"),
            typical: Ref("pietro"),
            top: Ref("poddasze"),
        ),
        Choice([
            (6, Roof(shape: Gable(pitch_deg: 40), material: "roof_tile_red", dormers: (1, 3))),
            (3, Roof(shape: Hip(pitch_deg: 38), material: "roof_tile_red", dormers: (2, 4))),
            (2, Roof(shape: Flat, material: "roof_felt")),
        ]),
    ],
    refs: [
        // Parter: witryny niemal na całą wysokość i przejazd bramny, gdy front szeroki.
        ("parter_uslugowy", Seq([
            Fill("brick_red"),
            Comp(thickness_m: 1.2, faces: [
                (Front, Repeat(axis: U, step_m: 5.0, pad_m: 1.5, rule: Split(axis: W, parts: [
                    (Abs(0.5), Nothing),
                    (Abs(2.9), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
        ("pietro", Seq([
            Choice([
                (5, Fill("stucco")),
                (3, Fill("brick_red")),
                (2, Fill("brick_yellow")),
            ]),
            Comp(thickness_m: 1.25, faces: [
                (Front, Repeat(axis: U, step_m: 4.6, pad_m: 1.3, rule: Split(axis: W, parts: [
                    (Abs(0.9), Nothing),
                    (Abs(1.4), Void),
                    (Rel(1.0), Nothing),
                ]))),
                (Back, Repeat(axis: U, step_m: 4.8, pad_m: 1.4, rule: Split(axis: W, parts: [
                    (Abs(1.0), Nothing),
                    (Abs(1.4), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
            // Balkony od podwórza, nie od ulicy: kamienica stoi w pierzei bez cofnięcia,
            // więc od frontu wyszłyby poza działkę i przycięcie i tak by je skasowało.
            // Od oficyny jest dziedziniec, czyli miejsce — i tak to wygląda w mieście.
            Repeat(axis: U, step_m: 9.6, pad_m: 1.6, rule: Protrude(
                face: Back, m: 1.1,
                rule: Split(axis: W, parts: [
                    (Abs(0.6), Fill("brick_red")),
                    (Rel(1.0), Nothing),
                ]),
            )),
        ])),
        // Ostatnia kondygnacja cofnięta pod okap; przy drogiej ziemi bywa pełnym piętrem.
        ("poddasze", If(
            cond: LandValueAtLeast(4500000),
            then: Ref("pietro"),
            otherwise: Inset(m: 0.4, rule: Ref("pietro")),
        )),
    ],
    interior: (
        ground: (kind: Retail, area_m2: (45, 120)),
        typical: (kind: Dwelling, area_m2: (38, 95)),
        top: (kind: Dwelling, area_m2: (30, 60)),
        circulation_share: 0.14,
    ),
)
