// Office/Commercial — kamienica biurowa: bank, towarzystwo ubezpieczeniowe, redakcja.
// Kamienny cokół na dwie kondygnacje, wyżej regularna siatka okien, attyka zamiast dachu.
// Zamyka `office` w pierścieniach przed 1918, gdzie `biurowiec.ron` się nie stosuje.
(
    schema_version: 1,
    id: "kamienica_biurowa",
    applies: (
        zones: ["office", "commercial"],
        epochs: ["industrial", "interwar"],
        styles: [],
        land_value: (0, 30000000),
        frontage_m: (10.0, 70.0),
        depth_m: (10.0, 140.0),
        weight: 35,
    ),
    massing: (
        setback_front_m: 0.0,
        setback_side_m: 0.0,
        setback_back_m: 3.0,
        courtyard_min_m2: 120.0,
        max_depth_m: 20.0,
    ),
    rules: [
        Foundation(depth_m: 3.0, material: "granite", basements: 2),
        Floors(
            count: (4, 7),
            height_m: 3.6,
            ground_height_m: 5.0,
            ground: Ref("cokol"),
            typical: Ref("kondygnacja"),
            top: Ref("kondygnacja"),
        ),
        Roof(shape: Flat, material: "roof_sheet"),
    ],
    refs: [
        // Cokół kamienny z wysokimi otworami i wejściem pośrodku — reprezentacja
        // była tu funkcją, nie ozdobą.
        ("cokol", Seq([
            Fill("granite"),
            Comp(thickness_m: 1.5, faces: [
                (Front, Repeat(axis: U, step_m: 4.4, pad_m: 1.2, rule: Split(axis: W, parts: [
                    (Abs(0.8), Nothing),
                    (Abs(3.0), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
        ("kondygnacja", Seq([
            Choice([
                (5, Fill("sandstone")),
                (3, Fill("stucco")),
                (2, Fill("limestone")),
            ]),
            Comp(thickness_m: 1.3, faces: [
                (Front, Ref("siatka_okien")),
                (Back, Ref("siatka_okien")),
            ]),
        ])),
        ("siatka_okien", Repeat(axis: U, step_m: 4.4, pad_m: 1.5, rule: Split(axis: W, parts: [
            (Abs(1.0), Nothing),
            (Abs(1.8), Void),
            (Rel(1.0), Nothing),
        ]))),
    ],
    interior: (
        ground: (kind: Retail, area_m2: (80, 300)),
        typical: (kind: Office, area_m2: (45, 180)),
        top: (kind: Office, area_m2: (45, 180)),
        circulation_share: 0.2,
    ),
)
