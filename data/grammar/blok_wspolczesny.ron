// R3/R4 — apartamentowiec współczesny: parter usługowy, wyżej mieszkania, ostatnia
// kondygnacja cofnięta pod taras. Cofnięcie ostatniego piętra jest jedyną rzeczą, która
// z poziomu ulicy odróżnia go od bloku — i dlatego jest w bryle, a nie w materiale.
(
    schema_version: 1,
    id: "blok_wspolczesny",
    applies: (
        zones: ["r3", "r4"],
        epochs: ["transition", "contemporary"],
        styles: [],
        land_value: (0, 22000000),
        frontage_m: (10.0, 140.0),
        depth_m: (5.0, 160.0),
        weight: 40,
    ),
    massing: (
        setback_front_m: 3.0,
        setback_side_m: 2.0,
        setback_back_m: 6.0,
        max_depth_m: 15.0,
    ),
    rules: [
        Foundation(depth_m: 3.0, material: "concrete", basements: 2),
        Floors(
            count: (4, 9),
            height_m: 2.9,
            ground_height_m: 3.8,
            ground: Ref("parter_uslugowy"),
            typical: Ref("pietro_z_balkonami"),
            top: Ref("ostatnie_pietro"),
        ),
        Roof(shape: Flat, material: "roof_felt"),
    ],
    refs: [
        ("parter_uslugowy", Seq([
            Fill("concrete"),
            Comp(thickness_m: 1.3, faces: [
                (Front, Repeat(axis: U, step_m: 6.0, pad_m: 1.2, rule: Split(axis: W, parts: [
                    (Abs(0.4), Nothing),
                    (Abs(2.6), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
        ("pietro", Seq([
            Choice([
                (5, Fill("plaster_white")),
                (3, Fill("stucco")),
                (2, Fill("glass")),
            ]),
            Comp(thickness_m: 1.2, faces: [
                (Front, Ref("okna_szerokie")),
                (Back, Ref("okna_szerokie")),
            ]),
        ])),
        ("okna_szerokie", Repeat(axis: U, step_m: 5.0, pad_m: 1.0, rule: Split(axis: W, parts: [
            (Abs(0.5), Nothing),
            (Abs(1.9), Void),
            (Rel(1.0), Nothing),
        ]))),
        ("pietro_z_balkonami", Seq([
            Ref("pietro"),
            Repeat(axis: U, step_m: 5.0, pad_m: 1.0, rule: Protrude(
                face: Front, m: 1.4,
                rule: Split(axis: W, parts: [
                    (Abs(0.6), Fill("concrete")),
                    (Rel(1.0), Nothing),
                ]),
            )),
        ])),
        // Taras: ostatnia kondygnacja schowana o 2 m, więc dach dolnej części zostaje
        // odsłonięty. Przy drogiej ziemi cofnięcie jest mniejsze — metr kwadratowy waży.
        ("ostatnie_pietro", If(
            cond: LandValueAtLeast(9000000),
            then: Inset(m: 0.8, rule: Ref("pietro")),
            otherwise: Inset(m: 2.0, rule: Ref("pietro")),
        )),
    ],
    interior: (
        ground: (kind: Retail, area_m2: (50, 200)),
        typical: (kind: Dwelling, area_m2: (40, 96)),
        top: (kind: Dwelling, area_m2: (60, 140)),
        circulation_share: 0.17,
    ),
)
