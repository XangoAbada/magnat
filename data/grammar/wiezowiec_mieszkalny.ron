// R5 — wieżowiec mieszkalny. `wiezowiec.ron` jest biurowy i cały ze szkła; ten ma
// balkony na każdej kondygnacji i koronę schodkową u góry, czyli dwie rzeczy, po których
// z odległości dzielnicy widać, że mieszkają w nim ludzie.
(
    schema_version: 1,
    id: "wiezowiec_mieszkalny",
    applies: (
        zones: ["r5", "r4"],
        epochs: ["transition", "contemporary"],
        styles: [],
        land_value: (1500000, 40000000),
        frontage_m: (16.0, 90.0),
        depth_m: (16.0, 120.0),
        weight: 35,
    ),
    massing: (
        setback_front_m: 5.0,
        setback_side_m: 5.0,
        setback_back_m: 7.0,
        max_depth_m: 24.0,
    ),
    rules: [
        Foundation(depth_m: 4.0, material: "concrete", basements: 2),
        Floors(
            count: (12, 24),
            height_m: 2.9,
            ground_height_m: 4.2,
            ground: Ref("parter"),
            typical: Ref("kondygnacja_z_balkonami"),
            top: Ref("korona"),
        ),
        Roof(shape: Flat, material: "roof_felt"),
    ],
    refs: [
        ("parter", Seq([
            Fill("concrete"),
            Comp(thickness_m: 1.4, faces: [
                (Front, Repeat(axis: U, step_m: 5.0, pad_m: 1.0, rule: Split(axis: W, parts: [
                    (Abs(0.4), Nothing),
                    (Abs(3.0), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
        ("kondygnacja", Seq([
            Choice([
                (5, Fill("plaster_white")),
                (3, Fill("concrete_panel")),
                (2, Fill("glass")),
            ]),
            Comp(thickness_m: 1.2, faces: [
                (Front, Ref("okna")),
                (Back, Ref("okna")),
                (Side, Repeat(axis: V, step_m: 4.4, pad_m: 1.3, rule: Split(axis: W, parts: [
                    (Abs(0.8), Nothing),
                    (Abs(1.5), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
        ("okna", Repeat(axis: U, step_m: 4.4, pad_m: 1.2, rule: Split(axis: W, parts: [
            (Abs(0.8), Nothing),
            (Abs(1.6), Void),
            (Rel(1.0), Nothing),
        ]))),
        ("kondygnacja_z_balkonami", Seq([
            Ref("kondygnacja"),
            Repeat(axis: U, step_m: 8.8, pad_m: 2.2, rule: Protrude(
                face: Front, m: 1.3,
                rule: Split(axis: W, parts: [
                    (Abs(0.6), Fill("concrete")),
                    (Rel(1.0), Nothing),
                ]),
            )),
            Repeat(axis: U, step_m: 8.8, pad_m: 2.2, rule: Protrude(
                face: Back, m: 1.3,
                rule: Split(axis: W, parts: [
                    (Abs(0.6), Fill("concrete")),
                    (Rel(1.0), Nothing),
                ]),
            )),
        ])),
        // Korona: ostatnia kondygnacja cofnięta ze wszystkich stron, bez balkonów.
        ("korona", Inset(m: 2.5, rule: Ref("kondygnacja"))),
    ],
    interior: (
        ground: (kind: Retail, area_m2: (60, 240)),
        typical: (kind: Dwelling, area_m2: (38, 110)),
        top: (kind: Dwelling, area_m2: (70, 180)),
        circulation_share: 0.22,
    ),
)
