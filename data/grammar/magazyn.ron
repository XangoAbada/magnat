// Logistyka: magazyn wysokiego składowania z rampą. Rampa jest wejściem `EntranceKind::Ramp`
// (test T4), a nie bryłą gramatyki — tu zostaje tylko pas bram przeładunkowych w elewacji.
(
    schema_version: 1,
    id: "magazyn",
    applies: (
        zones: ["logistics"],
        epochs: ["postwar", "transition", "contemporary"],
        styles: [],
        land_value: (0, 3000000),
        frontage_m: (12.0, 500.0),
        depth_m: (12.0, 500.0),
        weight: 50,
    ),
    massing: (
        setback_front_m: 18.0,
        setback_side_m: 8.0,
        setback_back_m: 8.0,
        max_depth_m: 80.0,
    ),
    rules: [
        Foundation(depth_m: 1.2, material: "concrete", basements: 0),
        Floors(
            count: (1, 1),
            height_m: 12.5,
            ground_height_m: 12.5,
            ground: Ref("magazyn"),
            typical: Ref("magazyn"),
            top: Ref("magazyn"),
        ),
        Roof(shape: Flat, material: "roof_sheet"),
    ],
    refs: [
        ("magazyn", Seq([
            Fill("steel_clad"),
            // Bramy przeładunkowe: przy samej ziemi, co 12 m.
            Comp(thickness_m: 1.2, faces: [
                (Front, Repeat(axis: U, step_m: 12.0, pad_m: 3.5, rule: Split(axis: W, parts: [
                    (Abs(0.2), Nothing),
                    (Abs(4.2), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
    ],
    interior: (
        ground: (kind: Storage, area_m2: (800, 12000)),
        typical: (kind: Storage, area_m2: (800, 12000)),
        top: (kind: Storage, area_m2: (800, 12000)),
        circulation_share: 0.05,
    ),
)
