// R2 — zabudowa szeregowa i bliźniacza. Bez cofnięć bocznych: segment styka się
// z sąsiadem, stąd wąski front i większa głębokość niż w R1.
(
    schema_version: 1,
    id: "szeregowiec",
    applies: (
        zones: ["r2"],
        epochs: ["interwar", "postwar", "transition", "contemporary"],
        styles: [],
        land_value: (0, 6000000),
        frontage_m: (4.5, 34.0),
        depth_m: (8.0, 120.0),
        weight: 40,
    ),
    massing: (
        setback_front_m: 3.0,
        setback_side_m: 0.3,
        setback_back_m: 7.0,
        max_depth_m: 12.0,
    ),
    rules: [
        Foundation(depth_m: 1.2, material: "concrete", basements: 1),
        Floors(
            count: (2, 3),
            height_m: 2.8,
            ground_height_m: 2.9,
            ground: Ref("sciana"),
            typical: Ref("sciana"),
            top: Ref("sciana"),
        ),
        Choice([
            (5, Roof(shape: Gable(pitch_deg: 38), material: "roof_tile_red", dormers: (0, 2))),
            (3, Roof(shape: Flat, material: "roof_felt")),
            (2, Roof(shape: Gable(pitch_deg: 25), material: "roof_sheet", dormers: (0, 0))),
        ]),
    ],
    refs: [
        ("sciana", Seq([
            Choice([
                (3, Fill("plaster_white")),
                (2, Fill("brick_yellow")),
                (1, Fill("stucco")),
            ]),
            Comp(thickness_m: 1.25, faces: [
                (Front, Repeat(axis: U, step_m: 4.4, pad_m: 1.2, rule: Split(axis: W, parts: [
                    (Abs(0.9), Nothing),
                    (Abs(1.4), Void),
                    (Rel(1.0), Nothing),
                ]))),
                (Back, Repeat(axis: U, step_m: 4.6, pad_m: 1.3, rule: Split(axis: W, parts: [
                    (Abs(0.9), Nothing),
                    (Abs(1.2), Void),
                    (Rel(1.0), Nothing),
                ]))),
            ]),
        ])),
    ],
    interior: (
        ground: (kind: Dwelling, area_m2: (45, 85)),
        typical: (kind: Dwelling, area_m2: (45, 85)),
        top: (kind: Dwelling, area_m2: (40, 75)),
        circulation_share: 0.08,
    ),
)
