// R4 — blok wielorodzinny 4–11 kondygnacji. Wielka płyta w pierścieniu powojennym,
// tynk cienkowarstwowy w późniejszych. Pasmowe okna zamiast pojedynczych: to jest
// różnica, którą widać z odległości dzielnicy.
(
    schema_version: 1,
    id: "blok",
    applies: (
        zones: ["r4"],
        epochs: ["postwar", "transition", "contemporary"],
        styles: [],
        land_value: (0, 12000000),
        frontage_m: (9.0, 200.0),
        depth_m: (5.0, 160.0),
        weight: 50,
    ),
    massing: (
        setback_front_m: 5.0,
        setback_side_m: 4.0,
        setback_back_m: 6.0,
        max_depth_m: 12.2,
    ),
    rules: [
        Foundation(depth_m: 2.0, material: "concrete", basements: 1),
        Floors(
            count: (4, 11),
            height_m: 2.7,
            ground_height_m: 2.9,
            ground: Ref("kondygnacja"),
            typical: Ref("kondygnacja_z_balkonami"),
            top: Ref("kondygnacja_z_balkonami"),
        ),
        Roof(shape: Flat, material: "roof_felt"),
    ],
    refs: [
        ("kondygnacja", Seq([
            Choice([
                (6, Fill("concrete_panel")),
                (4, Fill("plaster_white")),
            ]),
            Comp(thickness_m: 1.2, faces: [
                (Front, Ref("pasmo_okien")),
                (Back, Ref("pasmo_okien")),
            ]),
        ])),
        // Balkon co drugie pasmo okien. Wysięg 1,2 m mieści się w cofnięciu frontowym (5 m),
        // więc nie wychodzi z działki nawet na parterze — i dlatego blok może mieć balkony
        // od ulicy, a kamienica w pierzei tylko od podwórza.
        ("kondygnacja_z_balkonami", Seq([
            Ref("kondygnacja"),
            // Płyta 0,6 m liczona od spodu kondygnacji: przy voxelu 0,5 m w pionie
            // cieńsza zniknęłaby w zaokrągleniu, a balustrady i tak nie ma czym zrobić.
            Repeat(axis: U, step_m: 8.8, pad_m: 1.4, rule: Protrude(
                face: Front, m: 1.2,
                rule: Split(axis: W, parts: [
                    (Abs(0.6), Fill("concrete")),
                    (Rel(1.0), Nothing),
                ]),
            )),
        ])),
        ("pasmo_okien", Repeat(axis: U, step_m: 4.4, pad_m: 1.2, rule: Split(axis: W, parts: [
            (Abs(0.9), Nothing),
            (Abs(1.4), Void),
            (Rel(1.0), Nothing),
        ]))),
    ],
    interior: (
        ground: (kind: Dwelling, area_m2: (34, 72)),
        typical: (kind: Dwelling, area_m2: (34, 72)),
        top: (kind: Dwelling, area_m2: (34, 72)),
        circulation_share: 0.16,
    ),
)
