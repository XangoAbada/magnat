// Profil gospodarczy miasta: portowy (M2 §5.2, PRD §4.1).
//
// M2c dokłada sekcję `mix` — kwoty stref Etapu 4 (M2 §5.3, krok 2). `schema_version`
// podbity do 2.
//
// `shares` to udziały stref niemieszkaniowych w obszarze zurbanizowanym, `residential`
// łączny udział mieszkaniówki, a `density` jej rozkład na R1..R5 **w epoce startowej**:
// miasto z 1950 nie ma jeszcze wieżowców, miasto z 2020 ma ich trochę. Udziały są
// renormalizowane do 1 przy ładowaniu, więc liczą się proporcje, nie suma.
//
// `required` niesie **krotność**: dwa wpisy `Highway` to dwa wjazdy z dwóch stron mapy.
// Miasto z jednym wjazdem nie ma jak domknąć sieci arterii w cykl (reguła P4).
// `optional` to jedno losowanie na rodzaj, prawdopodobieństwo 0..=1.
// Port jest wymagany z definicji profilu. W regionie bez żeglownej wody nie powstanie
// i trafi na listę `missing_gates` w raporcie generacji — świadomie głośno, nie po cichu.
(
    schema_version: 2,
    required: [Highway, Highway, Port],
    optional: [
        (RailFreight, 0.85),
        (RailPassenger, 0.6),
        (Airport, 0.25),
    ],

    // Logistyka zamiast rolnictwa — place składowe przy nabrzeżu.
    mix: (
        shares: [
            (Commercial, 0.09),
            (Office, 0.06),
            (IndustryLight, 0.11),
            (IndustryHeavy, 0.07),
            (Logistics, 0.13),
            (Institutional, 0.05),
            (Green, 0.07),
            (Agriculture, 0.02),
            (Extraction, 0.01),
        ],
        residential: 0.39,
        density: [
            (Y1950, (0.34, 0.23, 0.28, 0.13, 0.02)),
            (Y1970, (0.30, 0.21, 0.24, 0.22, 0.03)),
            (Y1990, (0.27, 0.19, 0.22, 0.28, 0.04)),
            (Y2010, (0.25, 0.18, 0.20, 0.31, 0.06)),
            (Y2020, (0.24, 0.17, 0.19, 0.32, 0.08)),
        ],
    ),
)
