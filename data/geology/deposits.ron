// Złoża surowców (M1 §5.5, przebieg P9).
//
// Wagi są mnożone: `waga = base × region × profil × epoka`. Waga 0 w którymkolwiek wymiarze
// wyklucza typ całkowicie — tak wyłącza się ropę w regionie górskim albo węgiel w epoce 2020
// (istnieje, ale jest już wybrany, więc rodzi się z niezerowym `extracted`).
//
// `concentration` to udział surowca w skale w procentach; razem z gęstością materiału
// i objętością formacji daje zasoby w gramach (M1 §5.5) — całkowitoliczbowo, bez floatów.
(
    schema_version: 1,

    // Średni odstęp między zarodkami złóż w metrach. Siatka z losowym przesunięciem
    // w komórce daje rozkład zbliżony do Poissona bez kosztu odrzucania próbek —
    // przy 6000 złóż na mapie 16 km różnica jest niewidoczna, a koszt liczy się w sekundach.
    seed_spacing_m: 130,

    types: [
        (
            kind: "Coal",
            base_weight: 100,
            shape: "Seam",
            host: ["shale", "sandstone", "limestone"],
            depth_min_m: 20,
            depth_max_m: 180,
            size_min_m: 300,
            size_max_m: 1400,
            thickness_min_dm: 8,
            thickness_max_dm: 45,
            concentration_min: 45,
            concentration_max: 85,
            region: (mountain: 120, lowland: 100, river: 90, coastal: 70, desert: 40),
            profile: (industrial: 180, port: 80, university: 60, tourist: 40, agricultural: 60, mixed: 100),
            epoch: (y1950: 140, y1970: 120, y1990: 100, y2010: 70, y2020: 60),
        ),
        (
            kind: "IronOre",
            base_weight: 70,
            shape: "Ellipsoid",
            host: ["granite", "basalt", "shale"],
            depth_min_m: 15,
            depth_max_m: 200,
            size_min_m: 120,
            size_max_m: 600,
            thickness_min_dm: 200,
            thickness_max_dm: 900,
            concentration_min: 25,
            concentration_max: 65,
            region: (mountain: 160, lowland: 70, river: 60, coastal: 50, desert: 110),
            profile: (industrial: 170, port: 90, university: 60, tourist: 40, agricultural: 50, mixed: 100),
            epoch: (y1950: 130, y1970: 120, y1990: 100, y2010: 80, y2020: 70),
        ),
        (
            kind: "Oil",
            base_weight: 45,
            shape: "Trap",
            host: ["sandstone", "limestone"],
            depth_min_m: 60,
            depth_max_m: 220,
            size_min_m: 250,
            size_max_m: 900,
            thickness_min_dm: 150,
            thickness_max_dm: 600,
            concentration_min: 8,
            concentration_max: 25,
            region: (mountain: 20, lowland: 90, river: 80, coastal: 150, desert: 170),
            profile: (industrial: 150, port: 130, university: 60, tourist: 40, agricultural: 60, mixed: 100),
            epoch: (y1950: 90, y1970: 120, y1990: 130, y2010: 110, y2020: 100),
        ),
        (
            kind: "Gas",
            base_weight: 40,
            shape: "Trap",
            host: ["sandstone", "shale"],
            depth_min_m: 80,
            depth_max_m: 230,
            size_min_m: 300,
            size_max_m: 1100,
            thickness_min_dm: 150,
            thickness_max_dm: 500,
            concentration_min: 4,
            concentration_max: 14,
            region: (mountain: 30, lowland: 100, river: 90, coastal: 130, desert: 140),
            profile: (industrial: 140, port: 120, university: 70, tourist: 50, agricultural: 70, mixed: 100),
            epoch: (y1950: 60, y1970: 100, y1990: 130, y2010: 140, y2020: 140),
        ),
        (
            kind: "Aggregate",
            base_weight: 160,
            shape: "Ellipsoid",
            host: ["gravel", "sand", "limestone", "granite"],
            depth_min_m: 0,
            depth_max_m: 40,
            size_min_m: 150,
            size_max_m: 700,
            thickness_min_dm: 60,
            thickness_max_dm: 300,
            concentration_min: 60,
            concentration_max: 95,
            region: (mountain: 130, lowland: 120, river: 150, coastal: 110, desert: 120),
            profile: (industrial: 130, port: 100, university: 90, tourist: 80, agricultural: 90, mixed: 100),
            epoch: (y1950: 100, y1970: 100, y1990: 100, y2010: 100, y2020: 100),
        ),
        (
            kind: "ClayDeposit",
            base_weight: 110,
            shape: "Ellipsoid",
            host: ["clay", "shale"],
            depth_min_m: 0,
            depth_max_m: 30,
            size_min_m: 150,
            size_max_m: 600,
            thickness_min_dm: 40,
            thickness_max_dm: 180,
            concentration_min: 55,
            concentration_max: 90,
            region: (mountain: 60, lowland: 140, river: 150, coastal: 120, desert: 60),
            profile: (industrial: 120, port: 90, university: 80, tourist: 70, agricultural: 110, mixed: 100),
            epoch: (y1950: 100, y1970: 100, y1990: 100, y2010: 100, y2020: 100),
        ),
        (
            kind: "Groundwater",
            base_weight: 120,
            shape: "Aquifer",
            host: ["sand", "gravel", "sandstone", "limestone"],
            depth_min_m: 5,
            depth_max_m: 120,
            size_min_m: 400,
            size_max_m: 2000,
            thickness_min_dm: 80,
            thickness_max_dm: 500,
            concentration_min: 10,
            concentration_max: 30,
            region: (mountain: 70, lowland: 140, river: 160, coastal: 110, desert: 60),
            profile: (industrial: 110, port: 100, university: 100, tourist: 100, agricultural: 160, mixed: 100),
            epoch: (y1950: 100, y1970: 100, y1990: 100, y2010: 100, y2020: 100),
        ),
    ],

    // Jaki ułamek zasobów jest już wybrany na starcie, w promilach, per epoka.
    // Świat z 2020 roku zaczyna się z historią górniczą — i to widać w bilansie złóż,
    // nie tylko w opisie.
    historic_depletion_permille: (y1950: 20, y1970: 120, y1990: 280, y2010: 450, y2020: 560),
)
