// Polityka wydatkowa i długu miasta (M8a §5.1, WP1, PRD §6.8, §10.1).
//
// Ten plik mówi, **na co** miasto wydaje i **ile znosi długu** — nie mówi, ile ma
// pieniędzy. Tamto wynika z danin, a daniny są w `tax.ron`.
//
// Udziały są w punktach bazowych planu miesięcznego i **nie muszą sumować się
// do 10 000**: suma poniżej znaczy nadwyżkę odkładaną na rezerwę, powyżej — deficyt
// domykany cięciem albo obligacją. To jest wybór burmistrza (M8e), a tutaj stoi
// wartość startowa, z którą miasto rusza, zanim ktokolwiek zacznie rządzić.
//
// Podstawą planu są **wpływy z ostatnich dwunastu miesięcy podzielone przez dwanaście**,
// a nie wpływy zeszłego miesiąca: wpływy z CIT-u przychodzą raz w roku, więc miasto
// planujące z miesiąca na miesiąc raz w roku miałoby hossę, a jedenaście razy głód.
//
// Kolejność wpisów nie jest kontraktem — indeks bierze się z `SpendCategory`, a wpisu
// brakującego traktuje się jako zero.
(
    schema_version: 1,

    // Ile miesięcy wydatków miasto trzyma jako rezerwę, zanim zacznie wydawać nadwyżkę.
    reserve_target_months: 2,

    // Plan wydatków bieżących jako udział w podstawie.
    plan_bp: [
        (category: Education,          bp: 2200),
        (category: Health,             bp: 1500),
        (category: Police,             bp:  800),
        (category: Fire,               bp:  400),
        (category: Waste,              bp:  500),
        (category: Parks,              bp:  300),
        (category: Administration,     bp: 1100),
        (category: TransitSubsidy,     bp:  900),
        (category: RoadMaintenance,    bp: 1000),
        (category: CapitalInvestment,  bp:  800),
        (category: Subsidies,          bp:  200),
    ],

    // Awaryjne domknięcie deficytu. Cięcie idzie pierwsze, bo jest odwracalne;
    // obligacja dopiero wtedy, gdy cięcie sięgnęło dna.
    //
    // Dno jest wysoko z rozmysłu: miasto, które umie przyciąć wydatki do zera,
    // nigdy się nie zadłuża i cała mechanika długu byłaby martwa.
    max_cut_bp: 3000,
    // Minimalny nominał emisji — obligacji na pięć złotych nikt nie kupi.
    bond_min_principal: 50_000_000,
    bond_coupon_bp_per_year: 650,
    bond_term_months: 120,
    // Sufit zadłużenia: dług do wpływów rocznych, w punktach bazowych.
    // Powyżej niego miasto nie emituje i zostaje przy cięciu, choćby bolało (`T5`).
    debt_ceiling_bp: 20_000,
)
