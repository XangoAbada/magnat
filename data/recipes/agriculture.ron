// Punkty wejścia łańcuchów: rolnictwo i leśnictwo (M6a §5.4, KROK 1).
//
// Gospodarstwo **ma wejścia** (pasza, nawóz, woda, materiał siewny) i mimo to jest punktem
// wejścia: o tym decyduje flaga `source: Agriculture`, a nie pustka w `inputs`. Dokładnie
// po to to pole istnieje — bez niego domknięcie musiałoby zgadywać, a obora karmiona paszą
// z tej samej wsi wyglądałaby jak cykl bez wyjścia.
//
// Bilans masy tych receptur się nie domyka i **tak ma być**: zboże rośnie z gleby
// i ze słońca, a te nie są towarem.
//
// Pole pszenicy bierze ziarno siewne z czyszczalni, która bierze pszenicę z pola —
// to jest cykl i jest poprawny, bo przecina go flaga punktu wejścia (a w ostateczności
// import ziarna kwalifikowanego).
(
    schema_version: 2,
    recipes: [
        (
            key: "wheat_farming",
            source: Agriculture,
            inputs: [
                (good: "agri_fertilizer", mass_g: 20_000),
                (good: "agri_seed_wheat", mass_g: 18_000, min_quality: 60),
            ],
            outputs: [(good: "raw_wheat", mass_g: 1_000_000)],
            duration_minutes: 1440,
            labour: [("production_worker", 900)],
            machine_class: "field",
            quality: (base: 45, w_input: 35, w_skill: 15, w_tech: 20, w_machine: 10),
        ),
        (
            key: "potato_farming",
