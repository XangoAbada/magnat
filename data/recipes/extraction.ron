// Punkty wejścia łańcuchów: wydobycie (M6a §5.4, KROK 1 domknięcia).
//
// `source: Extraction(_)` jest **jawną flagą**, nie domysłem z pustych `inputs`.
// Bilans masy `Σ inputs == Σ outputs + process_loss` obowiązuje wyłącznie `Manufacturing`:
// masa kopaliny pochodzi ze złoża, a złoże nie jest towarem.
//
// Ilości są w **gramach na szarżę**, czas w minutach; `duration_minutes: 1440` znaczy
// „to jest wydajność dobowa". `yield` nie jest polem — liczy się z tych dwóch.
//
// `labour` to **osobominuty szarży**, czyli wielkość kosztowa. Obsada etatowa stoi
// po drugiej stronie granicy, w `data/buildings/*.ron` — to są dwie różne liczby.
(
    schema_version: 2,
    recipes: [
        (
            key: "coal_mining",
            source: Extraction(Coal),
            outputs: [(good: "raw_coal", mass_g: 1_200_000_000)],
            duration_minutes: 1440,
            energy_wh: 2_400_000,
            labour: [("production_worker", 420_000)],
            machine_class: "shaft_mining",
            emissions: (noise_db: 78),
        ),
        (
            key: "iron_ore_mining",
            source: Extraction(IronOre),
            outputs: [(good: "raw_iron_ore", mass_g: 900_000_000)],
            duration_minutes: 1440,
            energy_wh: 1_800_000,
            labour: [("production_worker", 300_000)],
            machine_class: "open_pit",
            emissions: (noise_db: 82),
        ),
        (
            key: "aggregate_quarry",
            source: Extraction(Aggregate),
            outputs: [
                (good: "raw_sand",   mass_g: 500_000_000),
                (good: "raw_gravel", mass_g: 700_000_000),
            ],
            duration_minutes: 1440,
            energy_wh: 900_000,
            labour: [("production_worker", 120_000)],
            machine_class: "open_pit",
            emissions: (noise_db: 84),
            cost_allocation: ByMarketValue,
        ),
        (
            key: "limestone_quarry",
            source: Extraction(Aggregate),
            outputs: [(good: "raw_limestone", mass_g: 800_000_000)],
            duration_minutes: 1440,
            energy_wh: 700_000,
            labour: [("production_worker", 110_000)],
            machine_class: "open_pit",
            emissions: (noise_db: 84),
        ),
        (
            key: "clay_pit",
            source: Extraction(ClayDeposit),
            outputs: [(good: "raw_clay", mass_g: 400_000_000)],
            duration_minutes: 1440,
            energy_wh: 300_000,
            labour: [("production_worker", 60_000)],
            machine_class: "open_pit",
            emissions: (noise_db: 76),
        ),
        (
            key: "oil_well",
            source: Extraction(Oil),
            outputs: [(good: "raw_crude_oil", mass_g: 300_000_000)],
            duration_minutes: 1440,
            energy_wh: 1_200_000,
            labour: [("production_worker", 90_000)],
            machine_class: "well",
            emissions: (noise_db: 70, plume: Chemical),
        ),
        (
            key: "gas_well",
            source: Extraction(Gas),
            outputs: [(good: "raw_natural_gas", mass_g: 60_000_000)],
            duration_minutes: 1440,
            energy_wh: 600_000,
            labour: [("production_worker", 70_000)],
            machine_class: "well",
        ),
        (
            key: "water_intake",
            source: Extraction(Groundwater),
            outputs: [(good: "raw_water", mass_g: 20_000_000_000)],
            duration_minutes: 1440,
            energy_wh: 4_000_000,
            labour: [("production_worker", 40_000)],
            machine_class: "pumping",
        ),
    ],
)
