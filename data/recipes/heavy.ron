// Przemysł ciężki i materiały budowlane (M2 §5.8).
//
// Każda receptura `Manufacturing` domyka bilans masy `Σ inputs == Σ outputs + process_loss`.
// Walidator sprawdza to przy ładowaniu i w CI, bo to z tej reguły wynika, że `yield`
// nie może być osobnym polem: wydajność liczy się z mas i czasu szarży (M2 §9.1/16).
(
    schema_version: 1,
    recipes: [
        (
            key: "coking",
            source: Manufacturing,
            inputs: [("coal", 1_400_000)],
            outputs: [("coke", 1_000_000)],
            process_loss_g: 400_000,
            duration_minutes: 720,
            labour: [("production_worker", 2_400)],
            machine_class: "coke_battery",
        ),
        (
            key: "blast_furnace",
            source: Manufacturing,
            inputs: [("iron_ore", 1_600_000), ("coke", 500_000), ("limestone", 200_000)],
            outputs: [("pig_iron", 1_000_000)],
            process_loss_g: 1_300_000,
            duration_minutes: 480,
            labour: [("production_worker", 3_200)],
            machine_class: "blast_furnace",
        ),
        (
            key: "steelmaking",
            source: Manufacturing,
            inputs: [("pig_iron", 1_050_000), ("limestone", 50_000)],
            outputs: [("steel", 1_000_000)],
            process_loss_g: 100_000,
            duration_minutes: 360,
            labour: [("production_worker", 2_800)],
            machine_class: "converter",
        ),
        (
            key: "rolling_mill",
            source: Manufacturing,
            inputs: [("steel", 1_000_000)],
            outputs: [("steel_sheet", 600_000), ("steel_sections", 350_000)],
            process_loss_g: 50_000,
            duration_minutes: 240,
            labour: [("production_worker", 1_900)],
            machine_class: "rolling_mill",
        ),
        (
            key: "cement_plant",
            source: Manufacturing,
            inputs: [("limestone", 1_200_000), ("clay", 300_000)],
            outputs: [("cement", 1_000_000)],
            process_loss_g: 500_000,
            duration_minutes: 480,
            labour: [("production_worker", 1_500)],
            machine_class: "rotary_kiln",
        ),
        (
            key: "concrete_plant",
            source: Manufacturing,
            inputs: [("cement", 300_000), ("gravel", 1_100_000), ("sand", 500_000), ("water_raw", 150_000)],
            outputs: [("concrete", 2_050_000)],
            process_loss_g: 0,
            duration_minutes: 60,
            labour: [("production_worker", 300)],
            machine_class: "mixer",
        ),
        (
            key: "brickworks",
            source: Manufacturing,
            inputs: [("clay", 1_100_000), ("sand", 200_000)],
            outputs: [("bricks", 1_150_000)],
            process_loss_g: 150_000,
            duration_minutes: 600,
            labour: [("production_worker", 1_200)],
            machine_class: "tunnel_kiln",
        ),
        (
            key: "glassworks",
            source: Manufacturing,
            inputs: [("sand", 800_000), ("limestone", 200_000), ("natural_gas", 60_000)],
            outputs: [("glass", 1_000_000)],
            process_loss_g: 60_000,
            duration_minutes: 480,
            labour: [("production_worker", 1_700)],
            machine_class: "glass_furnace",
        ),
        (
            key: "refinery",
            source: Manufacturing,
            inputs: [("crude_oil", 2_000_000)],
            outputs: [("fuel_petrol", 700_000), ("fuel_diesel", 800_000), ("heating_oil", 400_000)],
            process_loss_g: 100_000,
            duration_minutes: 120,
            labour: [("production_worker", 900)],
            machine_class: "distillation",
        ),
        (
            key: "petrochemical",
            source: Manufacturing,
            inputs: [("crude_oil", 900_000), ("natural_gas", 200_000)],
            outputs: [("plastic_granule", 1_000_000)],
            process_loss_g: 100_000,
            duration_minutes: 300,
            labour: [("production_worker", 1_400)],
            machine_class: "cracker",
        ),
        (
            key: "fertilizer_plant",
            source: Manufacturing,
            inputs: [("natural_gas", 400_000), ("water_raw", 700_000)],
            outputs: [("fertilizer", 1_000_000)],
            process_loss_g: 100_000,
            duration_minutes: 360,
            labour: [("production_worker", 1_100)],
            machine_class: "reactor",
        ),
        (
            key: "chemical_works",
            source: Manufacturing,
            inputs: [("rapeseed_oil", 300_000), ("fertilizer", 200_000), ("water_raw", 550_000)],
            outputs: [("detergent_base", 1_000_000)],
            process_loss_g: 50_000,
            duration_minutes: 300,
            labour: [("production_worker", 1_000)],
            machine_class: "reactor",
        ),
    ],
)
