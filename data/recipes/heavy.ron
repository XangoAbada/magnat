// Przemysł ciężki, materiały budowlane i rafinacja (M6a §5.4).
//
// Każda receptura `Manufacturing` domyka bilans masy `Σ inputs == Σ outputs + process_loss`.
// Walidator sprawdza to przy ładowaniu i w CI, bo to z tej reguły wynika, że `yield`
// nie może być osobnym polem: wydajność liczy się z mas i czasu szarży.
//
// Masa schodząca z bilansu **musi mieć kategorię** (`loss_kind`) — masa znikająca bez
// kategorii jest błędem, nie zaokrągleniem.
(
    schema_version: 2,
    recipes: [
        (
            key: "coking",
            source: Manufacturing,
            inputs: [(good: "raw_coal", mass_g: 1_400_000, min_quality: 45)],
            outputs: [(good: "mat_coke", mass_g: 1_000_000)],
            process_loss_g: 400_000,
            loss_kind: ProcessWaste,
            duration_minutes: 720,
            energy_wh: 120_000,
            labour: [("production_worker", 2_400)],
            machine_class: "coke_battery",
            setup: (minutes: 240, scrap_mass_g: 60_000),
            emissions: (noise_db: 72, pm_g: 4_200, co2_g: 900_000, plume: Soot),
        ),
        (
            key: "blast_furnace",
            source: Manufacturing,
            inputs: [
                (good: "raw_iron_ore",  mass_g: 1_600_000, min_quality: 40),
                (good: "mat_coke",      mass_g: 500_000),
                (good: "raw_limestone", mass_g: 200_000),
            ],
            outputs: [(good: "mat_pig_iron", mass_g: 1_000_000)],
            process_loss_g: 1_300_000,
            loss_kind: ProcessWaste,
            duration_minutes: 480,
            energy_wh: 340_000,
            labour: [("production_worker", 3_200)],
            machine_class: "blast_furnace",
            setup: (minutes: 600, scrap_mass_g: 400_000),
            emissions: (noise_db: 84, pm_g: 6_000, co2_g: 1_800_000, plume: Soot),
            quality: (base: 50, w_input: 40, w_skill: 15, w_tech: 20, w_machine: 15, cap_by_worst_input: true, bonus_qc: 4),
        ),
        (
            key: "steelmaking",
            source: Manufacturing,
            inputs: [
                (good: "mat_pig_iron",  mass_g: 1_050_000, min_quality: 45),
                (good: "raw_limestone", mass_g: 50_000),
            ],
            outputs: [(good: "mat_steel", mass_g: 1_000_000)],
            process_loss_g: 100_000,
            loss_kind: ProcessWaste,
            duration_minutes: 360,
            energy_wh: 420_000,
            labour: [("production_worker", 2_800)],
            machine_class: "converter",
            setup: (minutes: 90, scrap_mass_g: 20_000),
            emissions: (noise_db: 86, pm_g: 3_000, co2_g: 1_100_000, plume: Soot),
            quality: (base: 50, w_input: 40, w_skill: 20, w_tech: 20, w_machine: 15, cap_by_worst_input: true, bonus_qc: 5),
        ),
        (
            key: "rolling_mill",
            source: Manufacturing,
            inputs: [(good: "mat_steel", mass_g: 1_000_000, min_quality: 50)],
            outputs: [
                (good: "mat_steel_sheet",    mass_g: 600_000),
                (good: "mat_steel_sections", mass_g: 350_000),
            ],
            process_loss_g: 50_000,
            loss_kind: ProcessWaste,
            duration_minutes: 240,
            energy_wh: 260_000,
            labour: [("production_worker", 1_900)],
            machine_class: "rolling_mill",
            setup: (minutes: 120, scrap_mass_g: 30_000),
            emissions: (noise_db: 90),
            cost_allocation: ByMarketValue,
        ),
        (
            key: "cement_plant",
            source: Manufacturing,
            inputs: [
                (good: "raw_limestone", mass_g: 1_200_000),
                (good: "raw_clay",      mass_g: 300_000),
            ],
            outputs: [(good: "mat_cement", mass_g: 1_000_000)],
            process_loss_g: 500_000,
            loss_kind: ProcessWaste,
            duration_minutes: 480,
            energy_wh: 480_000,
            labour: [("production_worker", 1_500)],
            machine_class: "rotary_kiln",
            setup: (minutes: 300, scrap_mass_g: 50_000),
            emissions: (noise_db: 80, pm_g: 5_400, co2_g: 800_000, plume: Soot),
        ),
        (
            key: "concrete_plant",
            source: Manufacturing,
            inputs: [
                (good: "mat_cement", mass_g: 300_000, min_quality: 50),
                (good: "raw_gravel", mass_g: 1_100_000),
                (good: "raw_sand",   mass_g: 500_000),
            ],
            water_ml: 150_000,
            outputs: [(good: "mat_concrete", mass_g: 2_050_000)],
            process_loss_g: 0,
            duration_minutes: 60,
            energy_wh: 9_000,
            labour: [("production_worker", 300)],
            machine_class: "mixer",
            emissions: (noise_db: 76, pm_g: 800),
        ),
        // Prefabrykacja: beton ma w katalogu dokładnie jednego odbiorcę i to jest on.
        // Szarża to dwie płyty po 1,2 t na zbrojeniu z kształtowników.
        (
            key: "precast_plant",
            source: Manufacturing,
            inputs: [
                (good: "mat_concrete",       mass_g: 2_400_000, min_quality: 50),
                (good: "mat_steel_sections", mass_g: 60_000),
            ],
            outputs: [(good: "mat_precast_panel", mass_g: 2_400_000)],
            process_loss_g: 60_000,
            loss_kind: ProcessWaste,
            duration_minutes: 480,
            batch_mass_g: 2_460_000,
            energy_wh: 40_000,
            labour: [("production_worker", 900)],
            machine_class: "precast_bed",
            setup: (minutes: 90, scrap_mass_g: 120_000),
            emissions: (noise_db: 78, pm_g: 600),
            quality: (base: 50, w_input: 40, w_skill: 20, w_tech: 15, w_machine: 15, cap_by_worst_input: true, bonus_qc: 4),
        ),
        (
            key: "brickworks",
            source: Manufacturing,
            inputs: [
                (good: "raw_clay", mass_g: 1_100_000),
                (good: "raw_sand", mass_g: 200_000),
            ],
            outputs: [(good: "mat_bricks", mass_g: 1_150_000)],
            process_loss_g: 150_000,
            loss_kind: Drying,
            duration_minutes: 600,
            energy_wh: 190_000,
            labour: [("production_worker", 1_200)],
            machine_class: "tunnel_kiln",
            setup: (minutes: 180, scrap_mass_g: 25_000),
            emissions: (noise_db: 68, pm_g: 1_600, co2_g: 260_000, plume: Soot),
        ),
        (
            key: "glassworks",
            source: Manufacturing,
            inputs: [
                (good: "raw_sand",        mass_g: 800_000),
                (good: "raw_limestone",   mass_g: 200_000),
                (good: "raw_natural_gas", mass_g: 60_000),
            ],
            outputs: [(good: "mat_glass", mass_g: 1_000_000)],
            process_loss_g: 60_000,
            loss_kind: ProcessWaste,
            duration_minutes: 480,
            energy_wh: 310_000,
            labour: [("production_worker", 1_700)],
            machine_class: "glass_furnace",
            setup: (minutes: 360, scrap_mass_g: 80_000),
            emissions: (noise_db: 74, pm_g: 900, co2_g: 540_000, plume: Steam),
        ),

        // ── rafineria: pełne frakcjonowanie ropy (łańcuch referencyjny nr 2) ─────────
        //
        // Kolumna daje **osiem** strumieni z jednej tony ropy i to jest sedno tej receptury:
        // produkcja łączna, w której nie da się wytwarzać samej benzyny. Podział kosztu musi
        // iść za wartością rynkową, bo podział wg masy dałby asfalt droższy od benzyny —
        // absurd, który wywraca ceny w całym łańcuchu w dół. Dlatego każde wyjście `Main`
        // i `ByProduct` ma tu cenę odniesienia w katalogu; walidator tego pilnuje.
        //
        // Gaz rafineryjny jest `SelfConsumed`: nie tworzy partii, tylko zasila piece kolumny.
        // Pozostałość podestylacyjna jest `Waste` i ma koszt utylizacji, nie cenę.
        //
        // Ubytku procesowego nie ma: w kolumnie atmosferycznej nic nie ubywa, masa tylko
        // się rozdziela. `batch_mass_g` (12 t) jest większe od masy receptury, bo szarżą
        // rafinerii jest przerób godzinowy instalacji, a nie tona odniesienia.
        (
            key: "refinery_crude_fractionation",
            source: Manufacturing,
            inputs: [(good: "raw_crude_oil", mass_g: 1_000_000, min_quality: 55)],
            outputs: [
                (good: "fuel_petrol_95",         mass_g: 260_000, kind: Main),
                (good: "fuel_diesel_b7",         mass_g: 340_000, kind: Main),
                (good: "fuel_lpg",               mass_g: 45_000,  kind: Main),
                (good: "fuel_heating_oil",       mass_g: 160_000, kind: Main),
                (good: "mat_bitumen",            mass_g: 95_000,  kind: ByProduct),
                (good: "chem_lubricant_base",    mass_g: 40_000,  kind: ByProduct),
                (good: "fuel_refinery_gas",      mass_g: 42_000,  kind: SelfConsumed),
                (good: "waste_refinery_residue", mass_g: 18_000,  kind: Waste),
            ],
            process_loss_g: 0,
            duration_minutes: 60,
            batch_mass_g: 12_000_000,
            energy_wh: 1_740_000,
            labour: [("production_worker", 180)],
            machine_class: "refinery_cdu",
            setup: (minutes: 480, scrap_mass_g: 40_000_000),
            emissions: (noise_db: 82, pm_g: 1_200, co2_g: 2_400_000, wastewater_ml: 180_000, plume: Chemical),
            quality: (base: 50, w_input: 35, w_skill: 15, w_tech: 25, w_machine: 15, cap_by_worst_input: true, bonus_qc: 6),
            cost_allocation: ByMarketValue,
        ),

        (
            key: "petrochemical",
            source: Manufacturing,
            inputs: [
                (good: "raw_crude_oil",    mass_g: 900_000, min_quality: 50),
                (good: "raw_natural_gas",  mass_g: 200_000),
            ],
            outputs: [(good: "chem_plastic_granule", mass_g: 1_000_000)],
            process_loss_g: 100_000,
            loss_kind: ProcessWaste,
            duration_minutes: 300,
            energy_wh: 620_000,
            labour: [("production_worker", 1_400)],
            machine_class: "cracker",
            setup: (minutes: 300, scrap_mass_g: 90_000),
            emissions: (noise_db: 78, pm_g: 700, co2_g: 1_300_000, wastewater_ml: 120_000, plume: Chemical),
        ),
        (
            key: "fertilizer_plant",
            source: Manufacturing,
            inputs: [
                (good: "raw_natural_gas", mass_g: 400_000),
            ],
            water_ml: 700_000,
            outputs: [(good: "agri_fertilizer", mass_g: 1_000_000)],
            process_loss_g: 100_000,
            loss_kind: ProcessWaste,
            duration_minutes: 360,
            energy_wh: 480_000,
            labour: [("production_worker", 1_100)],
            machine_class: "reactor",
            emissions: (noise_db: 70, co2_g: 900_000, wastewater_ml: 90_000, plume: Chemical),
        ),
        (
            key: "chemical_works",
            source: Manufacturing,
            inputs: [
                (good: "food_rapeseed_oil", mass_g: 300_000),
                (good: "agri_fertilizer",   mass_g: 200_000),
            ],
            water_ml: 550_000,
            outputs: [(good: "chem_detergent_base", mass_g: 1_000_000)],
            process_loss_g: 50_000,
            loss_kind: ProcessWaste,
            duration_minutes: 300,
            energy_wh: 210_000,
            labour: [("production_worker", 1_000)],
            machine_class: "reactor",
            emissions: (noise_db: 68, wastewater_ml: 140_000, plume: Chemical),
        ),
    ],
)
