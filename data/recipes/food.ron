// Przetwórstwo spożywcze (M2 §5.8).
//
// Drożdżownia bierze mąkę, a piekarnia bierze drożdże — to jest zależność, nie cykl.
// Cykle w grafie receptur są normalne i pożądane, ale każdy musi mieć wejście z importu
// albo z wydobycia; w katalogu M2 nie ma ani jednego i tak ma zostać, dopóki M6 nie
// wprowadzi swoich (rafineria ↔ elektrownia).
(
    schema_version: 1,
    recipes: [
        (
            key: "milling",
            source: Manufacturing,
            inputs: [("wheat", 1_300_000)],
            outputs: [("flour", 1_000_000)],
            process_loss_g: 300_000,
            duration_minutes: 240,
            labour: [("production_worker", 500)],
            machine_class: "roller_mill",
        ),
        (
            key: "bakery",
            source: Manufacturing,
            inputs: [("flour", 700_000), ("water_raw", 380_000), ("yeast", 20_000)],
            outputs: [("bread", 1_000_000)],
            process_loss_g: 100_000,
            duration_minutes: 240,
            labour: [("production_worker", 1_600)],
            machine_class: "deck_oven",
        ),
        (
