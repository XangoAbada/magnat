            process_loss_g: 500_000,
            duration_minutes: 240,
            labour: [("production_worker", 1_800)],
            machine_class: "cutting_line",
        ),
        (
            key: "brewery",
            source: Manufacturing,
            inputs: [("wheat", 180_000), ("water_raw", 1_000_000), ("yeast", 10_000), ("sugar", 30_000)],
            outputs: [("beer", 1_200_000)],
            process_loss_g: 20_000,
