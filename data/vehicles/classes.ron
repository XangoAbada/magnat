// Katalog klas pojazdów (M4b, WP5). `VehicleClassId` to indeks w tej tablicy —
// kolejność jest kontraktem, bo wchodzi do komponentu pojazdu, a ten do zapisu gry.
//
// Wszystkie liczby są całkowite i wszystkie mnożniki są w promilach: wzór zużycia
// paliwa z M4d §5.4 nie ma prawa zobaczyć ani jednego floata, bo jego wynik wchodzi
// do ledgera, czyli do pieniądza (00 §2).
//
// `base_ml_per_100km` to zużycie odniesienia: pojazd pusty, teren płaski, prędkość
// z kubełka optymalnego. Reszta to mnożniki nakładane kolejno.
(
    schema_version: 2,

    // Mnożnik zużycia od prędkości średniej. Kubełek co 100 dkmh (10 km/h),
    // indeks = mean_speed_dkmh / 100, ostatni obowiązuje dla wszystkiego powyżej.
    // Krzywa jest w kształcie U: w korku pali się na jałowym, na autostradzie
    // na opór powietrza. Minimum wypada przy 50–60 km/h.
    speed_factor_permille: [1800, 1350, 1150, 1050, 1000, 980, 1000, 1060, 1150, 1280, 1450],

    // Mnożnik od ładunku: 1000 + load_g * load_slope_permille / kerb_mass_g.
    // 100 % masy własnej dokłada 30 % zużycia.
    load_slope_permille: 300,

    // Mnożnik od nachylenia: 1000 + grade_permille * grade_slope_permille,
    // przycięty z dołu do `grade_floor_permille` (zjazd nie zwraca paliwa w nieskończoność).
    grade_slope_permille: 15,
    grade_floor_permille: 600,

    // Cena detaliczna paliwa w groszach za litr (D9: w M4 stała z danych; M5 podmienia
    // na ofertę w `sim/economy`, M4 czyta przez `FuelPrices`, nie z pliku wprost).
    // Dla `Electric` jednostką jest grosz za kWh.
    fuel_price_gr: [
        (kind: Petrol,   price: 550),
        (kind: Diesel,   price: 520),
        (kind: Lpg,      price: 290),
        (kind: Electric, price: 75),
    ],

    classes: [
        (
            key: "car_small",
            fuel: Petrol,
            kerb_mass_g: 950_000,
            length_cm: 390,
            seats: 5,
            tank_ml: 45_000,
            refuel_threshold_permille: 150,
            base_ml_per_100km: 6_200,
            idle_ml_per_stop: 7,
            cold_start_ml: 55,
            wear_gr_per_100km: 2_600,
            top_speed_dkmh: 1_650,
            payload_g: 0,
            cargo_ml: 0,
            body: Box,
            haul_gr_per_km: 0,
        ),
        (
            key: "car_medium",
            fuel: Petrol,
            kerb_mass_g: 1_280_000,
            length_cm: 445,
            seats: 5,
            tank_ml: 58_000,
            refuel_threshold_permille: 150,
            base_ml_per_100km: 7_600,
            idle_ml_per_stop: 9,
            cold_start_ml: 70,
            wear_gr_per_100km: 3_400,
            top_speed_dkmh: 1_900,
            payload_g: 0,
            cargo_ml: 0,
            body: Box,
            haul_gr_per_km: 0,
        ),
        (
            key: "car_large",
            fuel: Diesel,
            kerb_mass_g: 1_680_000,
            length_cm: 485,
            seats: 5,
            tank_ml: 70_000,
            refuel_threshold_permille: 150,
            base_ml_per_100km: 7_100,
            idle_ml_per_stop: 11,
            cold_start_ml: 90,
            wear_gr_per_100km: 4_800,
            top_speed_dkmh: 2_100,
            payload_g: 0,
            cargo_ml: 0,
            body: Box,
            haul_gr_per_km: 0,
        ),
        (
            key: "van",
            fuel: Diesel,
            kerb_mass_g: 2_100_000,
            length_cm: 580,
            seats: 3,
            tank_ml: 80_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 9_400,
            idle_ml_per_stop: 14,
            cold_start_ml: 110,
            wear_gr_per_100km: 5_200,
            top_speed_dkmh: 1_600,
            payload_g: 1_200_000,
            cargo_ml: 8_000_000,
            body: Box,
            haul_gr_per_km: 210,
        ),
        // Autobus miejski (M4c/WP10). Dopisany **na końcu** — kolejność klas jest
        // kontraktem, bo `VehicleClassId` to indeks w tej tablicy i siedzi w komponencie
        // pojazdu, czyli w zapisie gry (`K-24`). `seats` jest tu pojemnością kursu,
        // a nie liczbą foteli: w szczycie jedzie się na stojąco.
        (
            key: "city_bus",
            fuel: Diesel,
            kerb_mass_g: 11_500_000,
            length_cm: 1_200,
            seats: 100,
            tank_ml: 250_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 35_000,
            idle_ml_per_stop: 45,
            cold_start_ml: 300,
            wear_gr_per_100km: 18_000,
            top_speed_dkmh: 900,
            payload_g: 0,
            cargo_ml: 0,
            body: Box,
            haul_gr_per_km: 0,
        ),
        // ── Ciężarówki (M6d, AG-1) ───────────────────────────────────────────────
        //
        // Dopisane **na końcu** — kolejność klas jest kontraktem zapisu gry (`K-24`).
        // To one dały `data/vehicles/` pierwszego konsumenta towarowego: do M6c trasa
        // ładunku szła przez atrapę o stałej odległości, więc porównanie „centrum
        // dystrybucyjne kontra dostawa bezpośrednia" rozstrzygało się arytmetyką
        // zamiast geografią.
        //
        // `seats` to kabina, nie ładunek. Ładunek jest w `payload_g` i `cargo_ml`,
        // a `body` mówi, co ta skrzynia w ogóle uwiezie.
        (
            key: "truck_box_12t",
            fuel: Diesel,
            kerb_mass_g: 7_500_000,
            length_cm: 900,
            seats: 3,
            tank_ml: 200_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 22_000,
            idle_ml_per_stop: 30,
            cold_start_ml: 220,
            wear_gr_per_100km: 12_000,
            top_speed_dkmh: 900,
            payload_g: 12_000_000,
            cargo_ml: 45_000_000,
            body: Box,
            haul_gr_per_km: 320,
        ),
        (
            key: "truck_semi_24t",
            fuel: Diesel,
            kerb_mass_g: 14_000_000,
            length_cm: 1_650,
            seats: 2,
            tank_ml: 600_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 31_000,
            idle_ml_per_stop: 42,
            cold_start_ml: 300,
            wear_gr_per_100km: 21_000,
            top_speed_dkmh: 900,
            payload_g: 24_000_000,
            cargo_ml: 90_000_000,
            body: Box,
            haul_gr_per_km: 420,
        ),
        (
            key: "truck_tipper_24t",
            fuel: Diesel,
            kerb_mass_g: 13_000_000,
            length_cm: 900,
            seats: 2,
            tank_ml: 400_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 34_000,
            idle_ml_per_stop: 45,
            cold_start_ml: 300,
            wear_gr_per_100km: 22_000,
            top_speed_dkmh: 850,
            payload_g: 24_000_000,
            cargo_ml: 20_000_000,
            body: Tipper,
            haul_gr_per_km: 420,
        ),
        (
            key: "truck_tanker_26t",
            fuel: Diesel,
            kerb_mass_g: 15_000_000,
            length_cm: 1_650,
            seats: 2,
            tank_ml: 600_000,
            refuel_threshold_permille: 250,
            base_ml_per_100km: 33_000,
            idle_ml_per_stop: 44,
            cold_start_ml: 310,
            wear_gr_per_100km: 24_000,
            top_speed_dkmh: 850,
            payload_g: 26_000_000,
            cargo_ml: 31_000_000,
            body: Tanker,
            haul_gr_per_km: 680,
        ),
        (
            key: "truck_reefer_12t",
            fuel: Diesel,
            kerb_mass_g: 8_600_000,
            length_cm: 900,
            seats: 3,
            tank_ml: 220_000,
            refuel_threshold_permille: 200,
            base_ml_per_100km: 27_000,
            idle_ml_per_stop: 38,
            cold_start_ml: 240,
            wear_gr_per_100km: 15_000,
            top_speed_dkmh: 900,
            payload_g: 12_000_000,
            cargo_ml: 40_000_000,
            body: Reefer,
            haul_gr_per_km: 380,
        ),
    ],
)
