// Parametry detaliczne towaru (M5b §5.3, §5.7).
//
// Ten plik **nie powtarza** ceny hurtowej ani gęstości — te są w `data/goods/`
// i tam zostają (jedno źródło prawdy o towarze). Tutaj jest wyłącznie to, czego
// handel detaliczny potrzebuje ponad katalog: do której kategorii zapasu
// gospodarstwa towar należy, jak długo leży na półce, ile trwa dostawa i jaki
// narzut bierze sklep.
//
// **Kolejność wpisów w obrębie kategorii jest rangą substytutu** (§5.4 krok 1):
// pierwszy chleb, potem ziemniak, potem mięso. Decyzja zakupowa schodzi po tej
// liście, kiedy pierwszy wybór nie przeszedł progu.
//
// `markup_bp` = narzut nad ceną hurtową w punktach bazowych (3000 = +30 %).
// `None` → `default_markup_bp`. **To jest cena startowa, nie polityka cenowa**:
// od M5c cenę ustala `reprice`, a ta kolumna zostaje tylko jako punkt wyjścia.
(
    schema_version: 3,
    default_markup_bp: 3200,

    // Jaki sklep czym handluje. `PlaceKind` przychodzi z archetypu zakładu
    // (`place_kind` w `data/buildings/commerce.ron`), więc asortyment wynika
    // z tego, co postawił generator M2, a nie z osobnej listy sklepów.
    shop_kinds: [
        (kind: Grocery,  cats: [Food, Drink, Hygiene, Cleaning]),
        (kind: Pharmacy, cats: [Medicine, Hygiene]),
        // `ponytail:` telefon ląduje w sklepie „odzieżowym" i to jest sufit nazwany.
        // `PlaceKind::Clothing` niesie archetyp `specialty_shop` („sklep
        // specjalistyczny"), czyli jedyne miejsce w generatorze, w którym towar
        // sztukowy spoza spożywczaka ma gdzie stanąć. Droga wyjścia: własny
        // `PlaceKind` dla elektroniki — kosztuje archetyp budynku, wagi generatora
        // i godziny handlu, czyli zmianę po stronie M2, nie M10.
        (kind: Clothing, cats: [Clothing, Comms]),
    ],

    goods: [
        // ── Food: chleb i ziemniak przed mięsem — to jest ranga substytutu ────────
        (key: "food_bread_wheat",    cat: Food,      quality: 52, shelf_life_days: 3,   lead_time_days: 1, markup_bp: Some(2600)),
        (key: "raw_potato",          cat: Food,      quality: 48, shelf_life_days: 60,  lead_time_days: 2, markup_bp: Some(3000)),
        (key: "food_vegetables",     cat: Food,      quality: 55, shelf_life_days: 10,  lead_time_days: 1, markup_bp: Some(3400)),
        (key: "food_milk",           cat: Food,      quality: 56, shelf_life_days: 7,   lead_time_days: 1, markup_bp: Some(2800)),
        (key: "food_fruit",          cat: Food,      quality: 58, shelf_life_days: 8,   lead_time_days: 1, markup_bp: Some(3600)),
        (key: "food_poultry_meat",   cat: Food,      quality: 60, shelf_life_days: 4,   lead_time_days: 1, markup_bp: None),
        (key: "food_cheese",         cat: Food,      quality: 66, shelf_life_days: 30,  lead_time_days: 2, markup_bp: None),
        (key: "food_meat",           cat: Food,      quality: 70, shelf_life_days: 5,   lead_time_days: 1, markup_bp: Some(3800)),
        (key: "food_sugar",          cat: Food,      quality: 45, shelf_life_days: 720, lead_time_days: 3, markup_bp: Some(2400)),

        // ── Drink ────────────────────────────────────────────────────────────────
        (key: "food_juice",          cat: Drink,     quality: 55, shelf_life_days: 90,  lead_time_days: 2, markup_bp: Some(3400)),
        (key: "food_beer",           cat: Drink,     quality: 58, shelf_life_days: 180, lead_time_days: 2, markup_bp: Some(4000)),

        // ── Hygiene ──────────────────────────────────────────────────────────────
        (key: "cons_soap",           cat: Hygiene,   quality: 50, shelf_life_days: 720, lead_time_days: 3, markup_bp: Some(3600)),
        (key: "cons_toilet_paper",   cat: Hygiene,   quality: 48, shelf_life_days: 720, lead_time_days: 3, markup_bp: Some(3000)),
        (key: "cons_cosmetics",      cat: Hygiene,   quality: 72, shelf_life_days: 540, lead_time_days: 5, markup_bp: Some(6000)),

        // ── Cleaning ─────────────────────────────────────────────────────────────
        (key: "cons_detergent",      cat: Cleaning,  quality: 52, shelf_life_days: 720, lead_time_days: 3, markup_bp: Some(3400)),

        // ── Medicine ─────────────────────────────────────────────────────────────
        (key: "cons_medicine",       cat: Medicine,  quality: 78, shelf_life_days: 540, lead_time_days: 2, markup_bp: Some(2200)),

        // ── Clothing ─────────────────────────────────────────────────────────────
        (key: "cons_clothing",       cat: Clothing,  quality: 58, shelf_life_days: 0,   lead_time_days: 7, markup_bp: Some(8000)),
        (key: "cons_shoes",          cat: Clothing,  quality: 62, shelf_life_days: 0,   lead_time_days: 9, markup_bp: Some(9000)),

        // ── Comms ────────────────────────────────────────────────────────────────
        // Jedyny towar kategorii i jedyny towar w tym pliku, który **na starcie
        // nie istnieje na żadnej półce**: `Unlocks` trzyma go poza obiegiem, dopóki
        // ktoś nie odkryje `mobile_telephony` (M10c WP10.9).
        (key: "cons_mobile_phone",   cat: Comms,     quality: 68, shelf_life_days: 0,   lead_time_days: 5, markup_bp: Some(5200)),
    ],
)
