        "emissive_neon": [(180,240,255),(255,140,200),(160,255,180),(255,240,214)],
    },

    // Domyslne musza pokryc wszystkie dwanascie rol - bez tego walidator odrzuca plik.
    defaults: {
        "skin": "skin_common",
        "hair": "hair_common",
        "outfit_main": "outfit_nineties",
        "outfit_trim": "trim_muted",
        "accent": "accent_earth",
        "metal": "metal_steel",
        "glass": "glass_modern",
        "paint": "paint_full",
        "livery": "livery_muted",
        "sign": "sign_lit",
        "rubber": "rubber_black",
        "emissive": "emissive_lamp",
    },

    palettes: [
        // -- Epoka: ubranie, lakier, szklo i swiatlo zmieniaja sie razem z nia --------
        (district: "*", epoch: "1950", ramps: {
            "outfit_main": "outfit_postwar", "paint": "paint_early", "glass": "glass_green",
            "metal": "metal_steel", "emissive": "emissive_lamp", "sign": "sign_painted", "outfit_trim": "trim_muted",
        }),
        (district: "*", epoch: "1970", ramps: {
            "outfit_main": "outfit_seventies", "paint": "paint_full", "glass": "glass_green",
            "metal": "metal_steel", "emissive": "emissive_lamp", "sign": "sign_painted", "outfit_trim": "trim_muted",
        }),
        (district: "*", epoch: "1990", ramps: {
            "outfit_main": "outfit_nineties", "paint": "paint_full", "glass": "glass_modern",
            "metal": "metal_steel", "emissive": "emissive_lamp", "sign": "sign_lit", "outfit_trim": "trim_bright",
        }),
        (district: "*", epoch: "2010", ramps: {
            "outfit_main": "outfit_contemporary", "paint": "paint_full", "glass": "glass_modern",
            "metal": "metal_chrome", "emissive": "emissive_neon", "sign": "sign_lit", "outfit_trim": "trim_bright",
        }),
        (district: "*", epoch: "2020", ramps: {
            "outfit_main": "outfit_today", "paint": "paint_full", "glass": "glass_modern",
            "metal": "metal_chrome", "emissive": "emissive_neon", "sign": "sign_lit", "outfit_trim": "trim_bright",
        }),

        // -- Dzielnica: co w niej robia ludzie, tym sie ubieraja ----------------------
        // Pas przemyslowy i port chodza w roboczym niezaleznie od epoki; odblask
        // pojawia sie dopiero wtedy, gdy zaczyna istniec.
        (district: "industrial_belt", epoch: "*", ramps: {
            "outfit_main": "outfit_work", "accent": "accent_navy", "livery": "livery_muted",
        }),
        (district: "industrial_belt", epoch: "2010", ramps: {"outfit_main": "outfit_hivis"}),
        (district: "industrial_belt", epoch: "2020", ramps: {"outfit_main": "outfit_hivis"}),
        (district: "port_quarter", epoch: "*", ramps: {
            "outfit_main": "outfit_work", "accent": "accent_navy",
        }),
        (district: "port_quarter", epoch: "2020", ramps: {"outfit_main": "outfit_hivis"}),
        (district: "campus", epoch: "*", ramps: {
            "outfit_main": "outfit_academic", "accent": "accent_bright",
        }),
        (district: "village", epoch: "*", ramps: {
            "outfit_main": "outfit_rural", "accent": "accent_earth", "livery": "livery_muted",
        }),
        (district: "green_belt", epoch: "*", ramps: {"accent": "accent_earth"}),
        (district: "old_town", epoch: "*", ramps: {"outfit_trim": "trim_muted", "sign": "sign_painted"}),
        (district: "inner_city", epoch: "1990", ramps: {"livery": "livery_bright"}),
        (district: "inner_city", epoch: "2010", ramps: {
            "accent": "accent_bright", "livery": "livery_bright",
        }),
        (district: "inner_city", epoch: "2020", ramps: {
            "accent": "accent_bright", "livery": "livery_bright",
        }),
    ],
)
