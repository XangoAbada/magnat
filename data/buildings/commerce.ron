// Archetypy zakładów — handel, usługi, biura, logistyka (PRD §7.2, M2 §5.8 pkt 2 i 3).
//
// `per_pop` to **normatyw ludnościowy**: jedna placówka na tylu mieszkańców. Normatywy
// są wejściem do walidacji, a nie sztywną prawdą (§5.8): rozmieszczenie maksymalizuje
// pokrycie ludności, a nie trafia w liczbę co do jednego.
//
// Placówki bez `per_pop` i z `weight` > 0 są wypełniaczami — dostają działkę wtedy,
// kiedy normatywy są już nasycone, a strefa handlowa ma jeszcze wolne budynki.
(
    schema_version: 1,
    archetypes: [
        // ── handel detaliczny: normatywy z §5.8 pkt 2 ───────────────────────────────
        (key: "corner_shop",     sector: Retail, zones: ["commercial"], min_parcel_m2: 120,  m2_per_workplace: 54, wage_mult: 0.92, per_pop: Some(1500), place_kind: Some(Grocery),  weight: 70, consumes: [("mat_cardboard", 6_000)]),
        (key: "supermarket",     sector: Retail, zones: ["commercial"], min_parcel_m2: 1800, m2_per_workplace: 67, wage_mult: 0.96, per_pop: Some(12000), place_kind: Some(Grocery), consumes: [("mat_cardboard", 60_000)]),
        (key: "discount_store",  sector: Retail, zones: ["commercial"], min_parcel_m2: 1400, m2_per_workplace: 88, wage_mult: 0.90, per_pop: Some(10000), place_kind: Some(Grocery), consumes: [("mat_cardboard", 45_000)]),
        (key: "hypermarket",     sector: Retail, zones: ["commercial"], min_parcel_m2: 6000, m2_per_workplace: 77, wage_mult: 0.98, per_pop: Some(60000), place_kind: Some(Grocery), consumes: [("mat_cardboard", 180_000)]),
        (key: "petrol_station",  sector: Retail, zones: ["commercial", "logistics"], min_parcel_m2: 700, m2_per_workplace: 144, wage_mult: 0.98, per_pop: Some(8000), consumes: [("fuel_petrol_95", 900_000), ("fuel_diesel_b7", 400_000)]),
        (key: "pharmacy",        sector: Retail, zones: ["commercial"], min_parcel_m2: 120, m2_per_workplace: 42, wage_mult: 1.18, per_pop: Some(7000), place_kind: Some(Pharmacy)),
        (key: "bakery_shop",     sector: Retail, zones: ["commercial"], min_parcel_m2: 100, m2_per_workplace: 38, wage_mult: 0.90, per_pop: Some(6000), place_kind: Some(Grocery)),
        (key: "specialty_shop",  sector: Retail, zones: ["commercial"], min_parcel_m2: 150, m2_per_workplace: 48, wage_mult: 1.02, per_pop: Some(9000), place_kind: Some(Clothing), weight: 45),
        (key: "market_hall",     sector: Retail, zones: ["commercial"], min_parcel_m2: 2500, m2_per_workplace: 96, wage_mult: 0.88, per_pop: Some(50000), place_kind: Some(Grocery)),
        (key: "car_dealer",      sector: Retail, zones: ["commercial", "logistics"], min_parcel_m2: 1500, m2_per_workplace: 120, wage_mult: 1.16, per_pop: Some(45000)),

        // ── usługi konsumenckie: wypełniacze strefy handlowej ───────────────────────
        (key: "restaurant",      sector: Services, zones: ["commercial"], min_parcel_m2: 150, m2_per_workplace: 35, wage_mult: 0.92, weight: 55, place_kind: Some(Eatery)),
        (key: "service_point",   sector: Services, zones: ["commercial"], min_parcel_m2: 90,  m2_per_workplace: 45, wage_mult: 0.96, weight: 60, place_kind: Some(Social)),
        (key: "hotel",           sector: Services, zones: ["commercial", "office"], min_parcel_m2: 900, m2_per_workplace: 72, wage_mult: 1.04, weight: 12, place_kind: Some(Social)),

        // ── biura: mix epoki (§5.8 pkt 3) ──────────────────────────────────────────
        (key: "design_office",   sector: Office, zones: ["office", "commercial"], min_parcel_m2: 400, m2_per_workplace: 26, wage_mult: 1.10, weight: 60, epochs: ["postwar", "transition"], consumes: [("mat_paper", 9_000)]),
        (key: "it_office",       sector: Office, zones: ["office"], min_parcel_m2: 400, m2_per_workplace: 19, wage_mult: 1.45, weight: 60, epochs: ["transition", "contemporary"], consumes: [("mat_paper", 3_000)]),
        (key: "bank_branch",     sector: Office, zones: ["office", "commercial"], min_parcel_m2: 250, m2_per_workplace: 29, wage_mult: 1.30, weight: 30, consumes: [("mat_paper", 5_000)]),
        (key: "office_suite",    sector: Office, zones: ["office"], min_parcel_m2: 300, m2_per_workplace: 24, wage_mult: 1.12, weight: 90, consumes: [("mat_paper", 7_000)]),

        // ── media (M10b) ───────────────────────────────────────────────────────────
        // Redakcja jest biurem, nie halą: drukarnia stoi osobno w `industry.ron`
        // i to ona drukuje nakład. Gazeta zużywa papier, bo bez niego nie wychodzi;
        // radio i telewizja nie zużywają nic, co miasto produkuje — i to jest prawda
        // o nich, a nie luka w danych. Wagi są niskie, bo tytułów w mieście jest kilka,
        // a nie kilkadziesiąt; normatywu ludnościowego nie mają z tego samego powodu,
        // dla którego nie ma go biuro: gazeta powstaje z rynku reklamy, nie z liczby
        // mieszkańców na placówkę.
        (key: "newspaper",       sector: Office, zones: ["office", "commercial"], min_parcel_m2: 350, m2_per_workplace: 26, wage_mult: 1.14, weight: 10, consumes: [("mat_paper", 26_000)]),
        (key: "radio_station",   sector: Office, zones: ["office"], min_parcel_m2: 300, m2_per_workplace: 30, wage_mult: 1.16, weight: 6, epochs: ["postwar", "transition", "contemporary"]),
        (key: "tv_station",      sector: Office, zones: ["office"], min_parcel_m2: 1200, m2_per_workplace: 34, wage_mult: 1.28, weight: 4, epochs: ["transition", "contemporary"]),

        // ── logistyka ──────────────────────────────────────────────────────────────
        (key: "warehouse",       sector: Logistics, zones: ["logistics"], min_parcel_m2: 2500, m2_per_workplace: 512, wage_mult: 1.00, weight: 80, consumes: [("mat_cardboard", 30_000)]),
        (key: "freight_depot",   sector: Logistics, zones: ["logistics"], min_parcel_m2: 3500, m2_per_workplace: 448, wage_mult: 1.06, weight: 45, consumes: [("fuel_diesel_b7", 600_000)]),
        // Skład budowlany jest jedynym odbiorcą betonu, cegły i tarcicy w mieście, które
        // niczego nie buduje. Bez niego cała gałąź cement → beton nie miałaby popytu
        // i wypadłaby z bilansu, choć w danych jest.
        (key: "construction_yard", sector: Logistics, zones: ["logistics"], min_parcel_m2: 2000, m2_per_workplace: 416, wage_mult: 1.02, weight: 40,
            consumes: [("mat_concrete", 900_000), ("mat_bricks", 260_000), ("mat_lumber", 150_000), ("mat_cement", 40_000)]),
    ],
)
