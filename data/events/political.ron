// Zdarzenia polityczne (M8c WP5, PRD §11.2).
//
// **Zakres tej kategorii jest w M8c wąski i jest to decyzja, nie przeoczenie.**
// Rada miasta, burmistrz, przetargi i dotacje powstają w M8e; zdarzenie polityczne
// bez organu, który je podejmuje, byłoby rzutem kostką udającym politykę. Zostaje
// to, co jest polityką **handlową** i ma w M8c prawdziwe wejście: stawka celna
// klasy taryfowej (`data/trade/tariffs.ron`, klasa jest etykietą towaru — `K-38`).
//
// Stawka jest **poziomem**, nie zmianą: uchwała ustala cło na 25 %, a nie „o 5 pkt
// więcej niż poprzednio". Dlatego siła zdarzenia nie skaluje tych efektów —
// tak samo jak nie skaluje wyłączenia bloku energetycznego.
//
// Kierunek związku jest w obie strony i tak ma być: bezrobocie pcha miasto
// ku protekcjonizmowi, drożyzna — ku otwarciu granicy na żywność.
(
    schema_version: 1,

    events: [
        // Kontrola skarbowa (M8d WP8, PRD §10.4).
        //
        // To jest zdarzenie, a nie system, i to jest wykonanie `CF-1`: mechanizm
        // hazardu stoi w `sim/events` od M8c i drugiego losowania nie budujemy.
        // Sonda jest jedna i mówi wszystko — im więcej firma ukrywa, tym częściej
        // ktoś do niej zagląda. Przy zerowym udziale hazard schodzi do dziesiątej
        // części stawki bazowej i kontrola praktycznie nie przychodzi; przy 30 %
        // obrotu poza deklaracją mediana czasu do kontroli schodzi poniżej trzech
        // lat gry, co jest kryterium ukończenia WP8.
        //
        // Skutek w `SimParam` jest **drobny i prawdziwy**: kontrola wstrzymuje
        // pracę zakładu na te dwa tygodnie w kilku procentach. Dolegliwością nie
        // jest ten mnożnik, tylko domiar — a domiar liczy `sim/city`, bo daniny
        // nie są parametrem symulacji (T7: zdarzenia nie zadają cen ani kwot).
        (
            key: "political/tax_audit",
            category: Political,
            scope: Firm,
            trigger: (
                base_ppm: 900,
                // Wiek, a nie obsada. `MinFirmHeadcount(1)` odsiewał dwie trzecie
                // firm miasta — ale mierzył przy tym **znaną fikcję**: po M7f stoi
                // w mieście kilkanaście tysięcy nieobsadzonych etatów, więc „firma
                // bez pracownika" nie znaczy „firma bez działalności". Miesiąc od
                // założenia znaczy za to dokładnie to, co ma znaczyć: firma, która
                // nie domknęła jeszcze miesiąca, nie ma czego ukryć.
                gate: [MinFirmAgeDays(30)],
                factors: [
                    (probe: FirmUnreportedBps, curve: ([(0, 1000), (500, 4000), (1500, 12000), (3000, 30000), (5000, 45000)])),
                ],
            ),
            severity: (min_bps: 2000, max_bps: 8000, from: Some((FirmUnreportedBps, 0, 5000))),
            duration: FixedDays(14),
            effects: [
                SiteOutput(mul_bps: 9600, filter: Any),
            ],
            // **Bez przerwy między kontrolami i to jest świadome.** `cooldown_days`
            // liczy się **per definicja**, a nie per firma (`Events::in_cooldown`
            // patrzy na `last_end_day` definicji), więc 240 dób przerwy znaczyłoby
            // „całe miasto ma spokój przez dwa trzecie roku, bo jedna firma dostała
            // kontrolę". Pomiar: 3 kontrole na 200 dób przy hazardzie 1 404 ppm
            // i 213 kandydatach, czyli dwudziesta część tego, co mówił hazard.
            // Powtórce u tej samej firmy zapobiega `Events::busy(def, scope)`.
            cooldown_days: 0,
            max_concurrent: 12,
            chronicle: "event.political.tax_audit",
        ),

        (
            key: "political/tariff_hike",
            category: Political,
            scope: World,
            trigger: (
                base_ppm: 700,
                factors: [
                    (probe: UnemploymentPermille, curve: ([(40, 6000), (80, 10000), (180, 45000)])),
                ],
            ),
            severity: (min_bps: 4000, max_bps: 10000, from: None),
            duration: RangeDays(180, 720),
            effects: [
                Duty(class: "industrial", bp: 2500),
            ],
            cooldown_days: 360,
            max_concurrent: 1,
            chronicle: "event.political.tariff_hike",
        ),

        (
            key: "political/tariff_cut",
            category: Political,
            scope: World,
            trigger: (
                base_ppm: 700,
                factors: [
                    (probe: UnemploymentPermille, curve: ([(20, 30000), (80, 10000), (180, 4000)])),
                ],
            ),
            severity: (min_bps: 4000, max_bps: 10000, from: None),
            duration: RangeDays(180, 720),
            effects: [
                Duty(class: "industrial", bp: 100),
            ],
            cooldown_days: 360,
            max_concurrent: 1,
            chronicle: "event.political.tariff_cut",
        ),

        // Zniesienie cła na żywność przy drożyźnie. To jest dokładnie ta decyzja,
        // którą §5.5 A zapowiada na końcu kaskady suszy — tyle że podjęta odruchowo,
        // bo rady miasta jeszcze nie ma.
        (
            key: "political/food_tariff_relief",
            category: Political,
            scope: World,
            trigger: (
                base_ppm: 600,
                factors: [
                    (probe: CpiYoyBp, curve: ([(0, 4000), (300, 10000), (1500, 50000)])),
                ],
            ),
            severity: (min_bps: 4000, max_bps: 10000, from: None),
            duration: RangeDays(90, 360),
            effects: [
                Duty(class: "food", bp: 0),
            ],
            cooldown_days: 360,
            max_concurrent: 1,
            chronicle: "event.political.food_tariff_relief",
        ),

        // Akcyzowa podwyżka cła na paliwo. Rzadka i długa — zmiana stawki paliwowej
        // przechodzi przez koszt transportu do każdej ceny w mieście, więc ma prawo
        // być decyzją, a nie tygodniowym kaprysem.
        (
            key: "political/fuel_tariff_hike",
            category: Political,
            scope: World,
            trigger: (
                base_ppm: 600,
                factors: [
                    (probe: CpiYoyBp, curve: ([(0, 20000), (600, 10000), (1500, 4000)])),
                ],
            ),
            severity: (min_bps: 4000, max_bps: 10000, from: None),
            duration: RangeDays(180, 540),
            effects: [
                Duty(class: "fuel", bp: 1500),
            ],
            cooldown_days: 540,
            max_concurrent: 1,
            chronicle: "event.political.fuel_tariff_hike",
        ),

        // Embargo na surowce. Dwa skutki naraz i to jest jego istota: cło rośnie,
        // a dostawca z zewnątrz i tak podnosi cenę, bo kolejka po surowiec jest
        // dłuższa. Jedno bez drugiego byłoby połową zdarzenia.
        (
            key: "political/raw_embargo",
            category: Political,
            scope: World,
            trigger: (
                base_ppm: 400,
                factors: [
                    (probe: MoodMean, curve: ([(-40, 25000), (0, 10000), (40, 6000)])),
                ],
            ),
            severity: (min_bps: 4000, max_bps: 10000, from: None),
            duration: RangeDays(60, 240),
            effects: [
                Duty(class: "raw", bp: 4000),
                ExternalPrice(good: "raw_iron_ore", mul_bps: 14000),
            ],
            cooldown_days: 720,
            max_concurrent: 1,
            chronicle: "event.political.raw_embargo",
        ),
    ],
)
